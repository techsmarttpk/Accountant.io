# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# Postgres in production; the sqlite default in app/core/config.py is only
# for zero-setup local development.
DATABASE_URL=postgresql+asyncpg://accountant:accountant@localhost:5432/accountant

# Shared secret the bot process must send on every backend request.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=changeme-generate-a-real-secret

# From @BotFather. Rotate immediately if this ever leaks — it grants full
# control of the bot.
TELEGRAM_BOT_TOKEN=
BACKEND_BASE_URL=http://api:8000

STT_PROVIDER=google_web
LOG_JSON=true
LOG_LEVEL=INFO
